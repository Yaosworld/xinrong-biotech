{
  "name": "biotech-official-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c green,cyan \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "npm --prefix server run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "generate-json": "node scripts/generate-json.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@vueuse/core": "^10.7.0",
    "dompurify": "^3.3.0",
    "element-plus": "^2.4.0",
    "marked": "^18.0.11",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.0",
    "sass": "^1.69.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "xlsx": "^0.18.5"
  }
}
